# --- Sanity (content + admin) ---
# From sanity.io/manage after you create your project. See SETUP.md step 2.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# A token with "Editor" rights, used server-side for draft preview and the /post screen. Never expose this with NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=

# --- Passcodes for the /post quick-post screen ---
# Any random long string (generate with: openssl rand -base64 32). Used to
# sign the /post login cookie — never shown to visitors.
POST_SESSION_SECRET=
# Your own passcode — pick anything, e.g. a memorable phrase or PIN. Full publish rights.
OWNER_PASSCODE=
# Optional: a second passcode for an assistant. Leave blank to turn assistant
# access off entirely. Anything they post saves as a draft for you to review.
ASSISTANT_PASSCODE=

# --- Contact form email (Resend, free tier) ---
RESEND_API_KEY=
# Where enquiry notifications land.
CONTACT_NOTIFY_EMAIL=hello@movelstudio.com
# Must be a domain you verified in Resend (see SETUP.md step 5).
CONTACT_FROM_EMAIL=MOVEL <hello@movelstudio.com>

# --- Cloudflare Turnstile (spam protection, free) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

NEXT_PUBLIC_SITE_URL=https://movelstudio.com
